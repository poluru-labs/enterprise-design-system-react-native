{
  "name": "@poluru-labs/enterprise-design-system-react-native",
  "version": "1.0.0",
  "description": "Enterprise Design Systems for React Native — TypeScript, tokens, icons, light/dark themes.",
  "author": {
    "name": "Subrahmanyam Poluru",
    "email": "subrahmanyam@polurulabs.com",
    "url": "https://github.com/subrahmanyampoluru"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.mjs --watchman=false",
    "test:watch": "jest --config jest.config.mjs --watchman=false --watch",
    "test:coverage": "jest --config jest.config.mjs --watchman=false --coverage",
    "storybook": "storybook dev -p 6010 --host 127.0.0.1 --ci",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist storybook-static coverage"
  },
  "keywords": [
    "design-system",
    "react-native",
    "typescript",
    "tokens",
    "enterprise",
    "jest"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-native": ">=0.73.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.76.9",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/manager-api": "^8.6.18",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.23",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-svg": "^15.11.2",
    "react-native-web": "^0.19.13",
    "react-test-renderer": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
